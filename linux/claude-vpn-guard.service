[Unit]
Description=Claude VPN Guard — блокировка Claude/Anthropic без VPN (выключить: claude-vpn-guard off)
Documentation=https://github.com/sharlupa/do-not-acces-claude-with-out-vpn
Wants=network-pre.target
Before=network-pre.target
After=nftables.service firewalld.service ufw.service

[Service]
Type=simple
ExecStart=/usr/local/bin/claude-vpn-guard daemon
# Снять правила при любой остановке службы (systemctl stop / disable --now)
ExecStopPost=/usr/local/bin/claude-vpn-guard stop
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
