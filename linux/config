# Настройки Claude VPN Guard. После изменения:
#   sudo systemctl restart claude-vpn-guard

# Домены, которые заглушаются в /etc/hosts, пока VPN выключен
# (сайт, приложение, Claude Code, его обновления и телеметрия)
DOMAINS="claude.ai www.claude.ai claude.com www.claude.com anthropic.com www.anthropic.com
api.anthropic.com console.anthropic.com docs.anthropic.com support.anthropic.com
statsig.anthropic.com a-cdn.anthropic.com a-api.anthropic.com s-cdn.anthropic.com
mcp-proxy.anthropic.com status.anthropic.com portal.anthropic.com
platform.claude.com code.claude.com docs.claude.com support.claude.com status.claude.com
downloads.claude.ai preview.claude.ai claudeusercontent.com www.claudeusercontent.com claude.site
http-intake.logs.us5.datadoghq.com browser-intake-us5-datadoghq.com"
# Домены, чьи IP дополнительно добавляются в фаервол (только размещённые у самой
# Anthropic — чтобы не заблокировать чужие сайты на общих CDN)
FIREWALL_DOMAINS="claude.ai claude.com api.anthropic.com platform.claude.com console.anthropic.com"

# Сети Anthropic, трафик к которым разрешён только через VPN-интерфейс
STATIC_V4="160.79.104.0/23"
STATIC_V6="2607:6bc0::/48"

# Типы интерфейсов, которые считаются VPN (65534 — любой TUN или WireGuard: hysteria2,
# sing-box, xray, OpenVPN, AmneziaWG...; 512 — PPP). Имя интерфейса при этом не важно.
VPN_IFACE_TYPES="65534 512"

# Дополнительно — интерфейсы по имени (например, TAP-адаптеры). Посмотреть свои: `ip link`
VPN_IFACES="tun* tap* wg* ppp* hy* ipsec* vti* utun* nordlynx* proton* mullvad* amn* outline*
nekoray* throne* hiddify* singbox* sing-box* sbox* xray* v2ray* clash* mihomo* Meta* tailscale* zt*"

# Прокси-клиенты без TUN (SOCKS5/HTTP-прокси). Пока такой процесс запущен, заглушки в
# /etc/hosts снимаются, а прямые соединения к Claude фаервол по-прежнему отклоняет.
PROXY_PROCESSES="hysteria hysteria2 sing-box xray v2ray v2raya mihomo clash clash-meta
nekoray nekobox throne hiddify hiddify-core naive trojan trojan-go ss-local sslocal tuic-client"

# Заглушки доменов в /etc/hosts, пока VPN выключен (чтобы DNS-запросы не утекали)
HOSTS_BLOCK="yes"

# Всплывающие уведомления на рабочем столе при смене состояния VPN
NOTIFY="yes"

# Как часто (сек) проверять VPN и обновлять IP-адреса доменов
CHECK_INTERVAL=3
RESOLVE_INTERVAL=600
