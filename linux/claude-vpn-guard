#!/usr/bin/env bash
# claude-vpn-guard — не пускает к Claude / Anthropic, если трафик идёт не через VPN.
#
# Как это работает:
#   * nftables-таблица `inet claude_vpn_guard` отклоняет любые пакеты к IP-адресам
#     Claude/Anthropic, которые уходят через НЕ-VPN интерфейс (eth*, wlan*, ...).
#     Если VPN поднят и маршрут идёт через tun*/wg*/... — пакеты проходят.
#     Это работает для браузера (включая DoH и QUIC), Claude Code CLI и любых приложений.
#   * Пока VPN выключен, в /etc/hosts добавляются заглушки для доменов Claude,
#     чтобы даже DNS-запросы к провайдеру не уходили.
#
# Команды: daemon | apply | stop | status | check

set -u

CONFIG_FILE="${CLAUDE_VPN_GUARD_CONFIG:-/etc/claude-vpn-guard/config}"
TABLE="claude_vpn_guard"
HOSTS_FILE="${HOSTS_FILE:-/etc/hosts}"
HOSTS_BEGIN="# BEGIN claude-vpn-guard"
HOSTS_END="# END claude-vpn-guard"
STATE_DIR="/run/claude-vpn-guard"

# ---- настройки по умолчанию (переопределяются в $CONFIG_FILE) ----
DOMAINS="claude.ai www.claude.ai claude.com www.claude.com anthropic.com www.anthropic.com
api.anthropic.com console.anthropic.com docs.anthropic.com support.anthropic.com
statsig.anthropic.com a-cdn.anthropic.com a-api.anthropic.com s-cdn.anthropic.com
mcp-proxy.anthropic.com status.anthropic.com portal.anthropic.com
platform.claude.com code.claude.com docs.claude.com support.claude.com status.claude.com
downloads.claude.ai preview.claude.ai claudeusercontent.com www.claudeusercontent.com claude.site
http-intake.logs.us5.datadoghq.com browser-intake-us5-datadoghq.com"
# Домены, чьи IP дополнительно добавляются в фаервол (только размещённые у самой
# Anthropic — чтобы не заблокировать чужие сайты на общих CDN)
FIREWALL_DOMAINS="claude.ai claude.com api.anthropic.com platform.claude.com console.anthropic.com"
# Собственные сети Anthropic (AS399358)
STATIC_V4="160.79.104.0/23"
STATIC_V6="2607:6bc0::/48"
# Интерфейсы, которые считаются VPN (шаблоны в стиле shell)
VPN_IFACES="tun* tap* wg* ppp* ipsec* vti* utun* nordlynx* proton* mullvad* amn* outline*
nekoray* throne* hiddify* singbox* sing-box* sbox* xray* v2ray* clash* mihomo* Meta* tailscale* zt*"
# IP для проверки маршрута (адрес api.anthropic.com / claude.ai)
PROBE_IP="160.79.104.10"
HOSTS_BLOCK="yes"
NOTIFY="yes"
CHECK_INTERVAL=3
RESOLVE_INTERVAL=600

# shellcheck disable=SC1090
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"

log() { echo "claude-vpn-guard: $*" >&2; }

need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        log "нужны права root (sudo)"
        exit 1
    fi
}

# ---------------- nftables ----------------

iface_rules() {
    local dir="$1" pat
    for pat in $VPN_IFACES; do
        printf '        %sname "%s" accept\n' "$dir" "$pat"
    done
}

ruleset() {
    local v4 v6
    v4=$(echo $STATIC_V4 | tr ' ' ',')
    v6=$(echo $STATIC_V6 | tr ' ' ',')
    cat <<EOF
table inet $TABLE {}
delete table inet $TABLE
table inet $TABLE {
    set static4 { type ipv4_addr; flags interval; auto-merge; ${v4:+elements = { $v4 }} }
    set static6 { type ipv6_addr; flags interval; auto-merge; ${v6:+elements = { $v6 }} }
    set dyn4 { type ipv4_addr; }
    set dyn6 { type ipv6_addr; }

    chain block {
        ip daddr @static4 meta l4proto tcp counter reject with tcp reset
        ip daddr @static4 counter reject with icmpx admin-prohibited
        ip daddr @dyn4 meta l4proto tcp counter reject with tcp reset
        ip daddr @dyn4 counter reject with icmpx admin-prohibited
        ip6 daddr @static6 meta l4proto tcp counter reject with tcp reset
        ip6 daddr @static6 counter reject with icmpx admin-prohibited
        ip6 daddr @dyn6 meta l4proto tcp counter reject with tcp reset
        ip6 daddr @dyn6 counter reject with icmpx admin-prohibited
    }

    chain output {
        type filter hook output priority filter; policy accept;
        oifname "lo" accept
$(iface_rules oif)
        jump block
    }

    # контейнеры / виртуальные машины, которые ходят в сеть через этот ПК
    chain forward {
        type filter hook forward priority filter; policy accept;
$(iface_rules oif)
        jump block
    }
}
EOF
}

nft_apply() {
    ruleset | nft -f - || { log "не удалось загрузить правила nftables"; return 1; }
}

nft_present() { nft list table inet "$TABLE" >/dev/null 2>&1; }

nft_remove() { nft delete table inet "$TABLE" 2>/dev/null || true; }

# Добавляет текущие IP доменов в динамические наборы (на случай, если Anthropic
# сменит адреса или часть доменов окажется вне STATIC_*). Вызывается только при
# включённом VPN, чтобы DNS-запросы не уходили мимо него.
resolve_domains() {
    local d ip v4="" v6=""
    for d in $FIREWALL_DOMAINS; do
        while read -r ip _; do
            case "$ip" in
                0.0.0.0|127.*|::|::1|"") ;;
                *:*) v6="$v6${v6:+,}$ip" ;;
                *.*) v4="$v4${v4:+,}$ip" ;;
            esac
        done < <(timeout 5 getent ahosts "$d" 2>/dev/null | awk '{print $1}' | sort -u)
    done
    [ -n "$v4" ] && nft add element inet "$TABLE" dyn4 "{ $v4 }" 2>/dev/null
    [ -n "$v6" ] && nft add element inet "$TABLE" dyn6 "{ $v6 }" 2>/dev/null
    return 0
}

# ---------------- VPN ----------------

is_vpn_iface() {
    local dev="$1" pat
    for pat in $VPN_IFACES; do
        # shellcheck disable=SC2053
        [[ "$dev" == $pat ]] && return 0
    done
    return 1
}

# Печатает интерфейс, через который сейчас пошёл бы трафик к Claude.
route_dev() {
    ip route get "$PROBE_IP" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1
}

vpn_active() {
    local dev
    dev=$(route_dev)
    [ -n "$dev" ] && is_vpn_iface "$dev"
}

# ---------------- /etc/hosts ----------------

hosts_strip() {
    sed "/^$HOSTS_BEGIN\$/,/^$HOSTS_END\$/d" "$HOSTS_FILE"
}

hosts_has_block() { grep -qx "$HOSTS_BEGIN" "$HOSTS_FILE" 2>/dev/null; }

hosts_write() {
    # пишем в тот же inode (/etc/hosts бывает bind-mount'ом)
    local tmp
    tmp=$(mktemp) || return 1
    cat > "$tmp"
    cat "$tmp" > "$HOSTS_FILE"
    rm -f "$tmp"
    flush_dns
}

hosts_block() {
    [ "$HOSTS_BLOCK" = "yes" ] || return 0
    hosts_has_block && return 0
    {
        hosts_strip
        echo "$HOSTS_BEGIN"
        local d
        for d in $DOMAINS; do
            echo "0.0.0.0 $d"
            echo ":: $d"
        done
        echo "$HOSTS_END"
    } | hosts_write
}

hosts_unblock() {
    hosts_has_block || return 0
    hosts_strip | hosts_write
}

flush_dns() {
    command -v resolvectl >/dev/null 2>&1 && resolvectl flush-caches 2>/dev/null
    command -v nscd >/dev/null 2>&1 && nscd -i hosts 2>/dev/null
    return 0
}

# ---------------- уведомления ----------------

notify_users() {
    [ "$NOTIFY" = "yes" ] || return 0
    command -v notify-send >/dev/null 2>&1 || return 0
    command -v loginctl >/dev/null 2>&1 || return 0
    local title="$1" body="$2" uid user
    while read -r uid user _; do
        [ -S "/run/user/$uid/bus" ] || continue
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            notify-send -a "Claude VPN Guard" -i network-vpn "$title" "$body" >/dev/null 2>&1 &
    done < <(loginctl list-users --no-legend 2>/dev/null)
}

# ---------------- команды ----------------

set_state() {
    local state="$1"
    mkdir -p "$STATE_DIR"
    echo "$state" > "$STATE_DIR/state"
    if [ "$state" = "vpn" ]; then
        hosts_unblock
        resolve_domains &
        log "VPN активен ($(route_dev)) — доступ к Claude разрешён"
        notify_users "VPN включён" "Доступ к Claude разрешён."
    else
        hosts_block
        log "VPN не активен (маршрут через '$(route_dev)') — Claude заблокирован"
        notify_users "Claude заблокирован" "VPN выключен — включите VPN, чтобы открыть Claude."
    fi
}

cmd_daemon() {
    need_root
    nft_apply || exit 1
    trap 'cmd_stop; exit 0' TERM INT
    local prev="" cur last_resolve
    last_resolve=$(date +%s)
    while :; do
        nft_present || { log "таблица nftables пропала — восстанавливаю"; nft_apply; }
        if vpn_active; then cur=vpn; else cur=novpn; fi
        if [ "$cur" != "$prev" ]; then
            set_state "$cur"
            prev=$cur
        fi
        if [ "$cur" = vpn ] && [ $(( $(date +%s) - last_resolve )) -ge "$RESOLVE_INTERVAL" ]; then
            resolve_domains &
            last_resolve=$(date +%s)
        fi
        sleep "$CHECK_INTERVAL" &
        wait $!
    done
}

cmd_apply() {
    need_root
    nft_apply || exit 1
    if vpn_active; then set_state vpn; else set_state novpn; fi
    wait
}

cmd_stop() {
    need_root
    nft_remove
    hosts_unblock
    rm -rf "$STATE_DIR"
    log "защита снята"
}

cmd_status() {
    local dev
    dev=$(route_dev)
    echo "Маршрут к Claude ($PROBE_IP): ${dev:-нет}"
    if vpn_active; then
        echo "VPN:        АКТИВЕН — Claude доступен"
    else
        echo "VPN:        НЕ АКТИВЕН — Claude заблокирован"
    fi
    if nft_present; then
        echo "nftables:   правила загружены"
    else
        echo "nftables:   правила НЕ загружены (служба остановлена?)"
    fi
    if hosts_has_block; then
        echo "/etc/hosts: заглушки доменов Claude включены"
    else
        echo "/etc/hosts: заглушек нет"
    fi
    if command -v systemctl >/dev/null 2>&1; then
        echo "Служба:     $(systemctl is-active claude-vpn-guard.service 2>/dev/null)"
    fi
}

# Для скриптов: код 0 — VPN активен, 1 — нет
cmd_check() { vpn_active; }

case "${1:-}" in
    daemon) cmd_daemon ;;
    apply)  cmd_apply ;;
    stop)   cmd_stop ;;
    status) cmd_status ;;
    check)  cmd_check ;;
    print-rules) ruleset ;;
    *)
        cat <<EOF
Использование: claude-vpn-guard <команда>
  status       показать состояние
  daemon       запустить слежение (используется systemd)
  apply        один раз загрузить правила
  stop         снять блокировку (правила и /etc/hosts)
  check        код возврата 0, если трафик к Claude идёт через VPN
  print-rules  показать правила nftables
Настройки: $CONFIG_FILE
EOF
        exit 2
        ;;
esac
