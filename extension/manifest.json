{
  "manifest_version": 3,
  "name": "Claude VPN Guard",
  "version": "1.0.0",
  "description": "Не пускает на claude.ai и anthropic.com, если вы выходите в интернет из страны, где Claude недоступен (то есть без VPN).",
  "minimum_chrome_version": "120",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage", "alarms", "tabs"],
  "host_permissions": [
    "*://*.claude.ai/*",
    "*://*.claude.com/*",
    "*://*.anthropic.com/*",
    "*://*.claudeusercontent.com/*",
    "*://*.claude.site/*",
    "https://www.cloudflare.com/*",
    "https://1.1.1.1/*",
    "https://one.one.one.one/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.claude.ai/*",
        "*://*.claude.com/*",
        "*://*.anthropic.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "page.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
